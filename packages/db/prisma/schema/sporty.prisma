// Sporty: grupper, arrangementer, bøter, meldinger osv. Flyttet fra Sporty Native (app-testing),
// som både appen og nettsiden bruker. Innloggingstabellene til Better Auth ligger i auth.prisma.

enum Role {
  admin
  /// Full admin-tilgang for Index (de som drifter Sporty). Vises ikke som eget merke.
  index
  subadmin
  /// Vanlig medlem som i tillegg kan gi fellesbot. Settes i hovedgruppen, der bøtene hører til.
  botsjef
  member
}

/// Status på et medlems «Jeg har betalt». Sub/admin sjekker i Vipps og godkjenner eller avviser.
enum PaymentStatus {
  pending
  approved
  rejected
}

enum AttendanceStatus {
  kommer
  kommer_ikke
}

enum EventType {
  trening
  kamp
  sosialt
  annet
}

enum UploadKind {
  image
  video
  file
}

enum FileKind {
  pdf
  image
  document
}

enum NotificationType {
  event
  attendance
  fine
  announcement
  poll
  payment
}

/// Et medlem i Sporty. Lages når noen logger inn (i appen eller på nettsiden), eller når
/// medlemslisten til et lag synkes fra tihlde.org. Innloggingen på nettsiden (Better Auth sin
/// `User`) er en egen tabell, koblet hit med `userId` når personen logger inn på nettsiden.
/// Feltene i resten av skjemaet heter `userId`/`user` av historiske grunner, men peker hit.
model Person {
  id       String  @id @default(cuid())
  name     String
  /// Mangler for medlemmer som er hentet fra en medlemsliste på tihlde.org (den har ikke e-post).
  /// Settes første gang de logger inn selv.
  email    String? @unique
  /// TIHLDE-kontoen (`sub` fra Photon). Samme id i appen, på nettsiden og i medlemslistene.
  photonId String? @unique
  /// Profilbildet fra tihlde.org (full lenke), eller null. Holdes oppdatert av synken med
  /// medlemslistene. Bilder lastet opp på tihlde.org er private og hentes med innloggingen.
  imageUrl String?
  /// Innloggingen på nettsiden, når personen har logget inn der.
  userId   String? @unique
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  memberships          Membership[]
  attendances          Attendance[]
  announcements        Announcement[]
  pollVotes            PollVote[]
  fines                Fine[]                @relation("FineReceiver")
  givenFines           Fine[]                @relation("FineGiver")
  paymentRequests      PaymentRequest[]
  paymentConfirmations PaymentConfirmation[]
  createdEvents        Event[]               @relation("EventCreator")
  uploads              Upload[]
  announcementComments AnnouncementComment[]
  createdPolls         Poll[]                @relation("PollCreator")
  pollComments         PollComment[]
  notifications        Notification[]
  conversations        ConversationMember[]
  messages             Message[]
  messageReactions     MessageReaction[]
  pushTokens           PushToken[]
  notificationSettings NotificationSettings?
  matchStats           MatchStat[]
}

model Group {
  id                   String  @id @default(cuid())
  name                 String
  /// Hex-farge som brukes til logo og banner.
  color                String
  description          String  @default("")
  /// Om medlemmene har posisjoner. Slås på per gruppe av admin, som også lager posisjonslisten.
  usesPositions        Boolean @default(false)
  /// Kampfakta (mål, kort og lignende) på kamper. Settes på hovedgruppen og gjelder også
  /// undergruppene, som bruker hovedgruppens hendelsestyper.
  usesMatchFacts       Boolean @default(true)
  /// Gruppen på tihlde.org (slug i Photon) for idrettslag som hentes derfra. Medlemskapene i
  /// slike grupper synkes fra TIHLDE når medlemmene logger inn. Null for grupper laget i Sporty.
  photonSlug           String? @unique
  /// Logoen til gruppen på tihlde.org (offentlig lenke). Vises som gruppebilde i appen.
  logoUrl              String?
  /// Om bøter er slått på for gruppen på tihlde.org. Da er tihlde.org kilden for bøtene.
  photonFinesActivated Boolean @default(false)
  /// Botsjefen på tihlde.org (Photon-id). Kan godkjenne bøter, sammen med lederne.
  photonFinesAdminId   String?
  /// Forsidebilde i banneret. Uten bilde brukes gruppefargen.
  coverUploadId        String?
  coverUpload          Upload? @relation("GroupCover", fields: [coverUploadId], references: [id], onDelete: SetNull)
  parentId             String?
  parent               Group?  @relation("Subgroups", fields: [parentId], references: [id], onDelete: Cascade)
  subgroups            Group[] @relation("Subgroups")

  memberships     Membership[]
  events          Event[]
  announcements   Announcement[]
  polls           Poll[]
  laws            Law[]
  fines           Fine[]
  paymentRequests PaymentRequest[]
  files           GroupFile[]
  notifications   Notification[]
  conversation    Conversation?
  places          Place[]
  positions       GroupPosition[]
  matchStatTypes  MatchStatType[]
}

model Membership {
  userId         String
  groupId        String
  role           Role           @default(member)
  /// Posisjonen i denne gruppen, fra gruppens egen posisjonsliste. Settes av sub-/admin.
  positionId     String?
  /// Satt når sub-/admin har gjort medlemmet inaktivt. null = aktivt medlem.
  inactiveSince  DateTime?
  /// Begrunnelsen for hvorfor medlemmet er inaktivt. Vises på profilen til medlemmet.
  inactiveReason String?
  user           Person         @relation(fields: [userId], references: [id], onDelete: Cascade)
  group          Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  position       GroupPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@id([userId, groupId])
}

/// En type hendelse i kampfakta, f.eks. Mål eller Gult kort. Admin i hovedgruppen lager listen,
/// og nye hovedgrupper får standardtypene.
model MatchStatType {
  id        String      @id @default(cuid())
  groupId   String
  name      String
  /// Rekkefølgen typene vises i (lavest først).
  sortOrder Int
  group     Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  stats     MatchStat[]

  @@unique([groupId, name])
  @@index([groupId, sortOrder])
}

/// Én hendelse i en kamp: en spiller som scoret, fikk kort osv. Slettes sammen med typen.
model MatchStat {
  id        String        @id @default(cuid())
  eventId   String
  typeId    String
  userId    String
  createdAt DateTime      @default(now())
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      MatchStatType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  user      Person        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

/// En posisjon i en gruppe med usesPositions, f.eks. Keeper eller Kant. Admin lager listen selv,
/// så hver idrett kan ha sine egne.
model GroupPosition {
  id          String       @id @default(cuid())
  groupId     String
  name        String
  /// Rekkefølgen posisjonene vises i (lavest først).
  sortOrder   Int
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([groupId, name])
  @@index([groupId, sortOrder])
}

model Event {
  id               String    @id @default(cuid())
  groupId          String
  group            Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdById      String?
  createdBy        Person?   @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  title            String
  type             EventType @default(annet)
  /// Laget man spiller mot. Bare for kamper.
  opponent         String?
  /// Notat med ekstra informasjon om arrangementet.
  description      String    @default("")
  locationName     String
  /// Gateadresse med postnummer og sted, f.eks. «Skansegata 20, 7014 Trondheim». Tom for eldre
  /// arrangementer og steder uten adresse.
  locationAddress  String    @default("")
  latitude         Float
  longitude        Float
  startsAt         DateTime
  /// Valgfri. Uten sluttid regnes arrangementet som ferdig når det starter.
  endsAt           DateTime?
  /// Resultat for kamper: egne mål og motstanderens mål. Registreres av sub-/admin.
  ourScore         Int?
  theirScore       Int?
  /// Valgfri. Etter fristen kan man ikke lenger svare på arrangementet.
  signupDeadline   DateTime?
  /// Valgfri. Når så mange har svart «kommer», kan ingen flere melde seg på.
  maxAttendees     Int?
  /// Når fellesbot ble gitt for arrangementet. Den kan bare gis én gang.
  collectiveFineAt DateTime?

  attendances Attendance[]
  fines       Fine[]
  matchStats  MatchStat[]

  @@index([groupId, startsAt])
}

/// Svar på et arrangement. Medlemmer uten rad her har ikke svart.
model Attendance {
  eventId   String
  userId    String
  status    AttendanceStatus
  /// Hvorfor man ikke kommer. Påkrevd ved «kommer ikke», tom ved «kommer».
  reason    String           @default("")
  updatedAt DateTime         @updatedAt
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      Person           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}

model Announcement {
  id            String                @id @default(cuid())
  groupId       String
  authorId      String
  title         String
  body          String
  allowComments Boolean               @default(true)
  createdAt     DateTime              @default(now())
  group         Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author        Person                @relation(fields: [authorId], references: [id])
  /// Bilder, video og vedlegg.
  uploads       Upload[]
  comments      AnnouncementComment[]
}

model AnnouncementComment {
  id             String       @id @default(cuid())
  announcementId String
  authorId       String
  body           String
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  author         Person       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([announcementId, createdAt])
}

/// En opplastet fil. Selve filen ligger på disk (storage/uploads/<id>), raden beskriver den.
/// Knyttes til en kunngjøring når den publiseres. Kan senere brukes til bilder på bøter o.l.
model Upload {
  id             String        @id @default(cuid())
  kind           UploadKind
  fileName       String
  mimeType       String
  sizeBytes      Int
  /// Rekkefølge i kunngjøringen.
  position       Int           @default(0)
  uploadedById   String
  announcementId String?
  createdAt      DateTime      @default(now())
  uploadedBy     Person        @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  coverForGroups Group[]       @relation("GroupCover")
}

model Poll {
  id            String        @id @default(cuid())
  groupId       String
  createdById   String?
  question      String
  description   String        @default("")
  /// Om man kan stemme på flere alternativer.
  allowMultiple Boolean       @default(false)
  /// Skjul resultatet for medlemmene til fristen har gått ut. Sub-/admin ser det alltid.
  hideVotes     Boolean       @default(false)
  allowComments Boolean       @default(true)
  closesAt      DateTime
  createdAt     DateTime      @default(now())
  group         Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy     Person?       @relation("PollCreator", fields: [createdById], references: [id], onDelete: SetNull)
  options       PollOption[]
  votes         PollVote[]
  comments      PollComment[]
}

model PollComment {
  id        String   @id @default(cuid())
  pollId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  author    Person   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([pollId, createdAt])
}

model PollOption {
  id       String     @id @default(cuid())
  pollId   String
  label    String
  position Int
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes    PollVote[]
}

/// En stemme på ett alternativ. Uten flervalg har hver bruker maks én rad per avstemning.
model PollVote {
  pollId   String
  optionId String
  userId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user     Person     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([optionId, userId])
  @@index([pollId, userId])
}

/// En paragraf i gruppens botregler, f.eks. "§1.00 Oppmøte".
model Law {
  id          String @id @default(cuid())
  groupId     String
  paragraph   String
  title       String
  description String @default("")
  group       Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fines       Fine[]

  @@unique([groupId, paragraph])
}

model Fine {
  id         String   @id @default(cuid())
  groupId    String
  lawId      String
  userId     String
  givenById  String
  reason     String
  /// Antall bøter. Bøter telles, de har ikke et kronebeløp.
  count      Int      @default(1)
  imageUri   String?
  paid       Boolean  @default(false)
  /// Fellesbot gitt til alle som ikke svarte på et arrangement.
  collective Boolean  @default(false)
  eventId    String?
  createdAt  DateTime @default(now())
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  law        Law      @relation(fields: [lawId], references: [id])
  user       Person   @relation("FineReceiver", fields: [userId], references: [id], onDelete: Cascade)
  givenBy    Person   @relation("FineGiver", fields: [givenById], references: [id])
  event      Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
}

/// Betalingsoppfordring postet av sub-/admin. Selve betalingen skjer utenfor appen (Vipps e.l.).
model PaymentRequest {
  id            String                @id @default(cuid())
  groupId       String
  createdById   String
  title         String
  description   String                @default("")
  amount        Int
  vippsNumber   String
  dueDate       DateTime
  createdAt     DateTime              @default(now())
  group         Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy     Person                @relation(fields: [createdById], references: [id])
  confirmations PaymentConfirmation[]
}

/// Medlemmet har selv markert at det har betalt. Teller først som betalt når sub/admin har godkjent.
model PaymentConfirmation {
  paymentId  String
  userId     String
  status     PaymentStatus  @default(pending)
  createdAt  DateTime       @default(now())
  reviewedAt DateTime?
  payment    PaymentRequest @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user       Person         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([paymentId, userId])
}

/// Steder som foreslås når sub-/admin lager arrangementer. groupId = null er felles for alle.
model Place {
  id         String   @id @default(cuid())
  groupId    String?
  name       String
  address    String   @default("")
  latitude   Float
  longitude  Float
  lastUsedAt DateTime @default(now())
  group      Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, lastUsedAt])
}

model GroupFile {
  id         String   @id @default(cuid())
  groupId    String
  name       String
  kind       FileKind
  sizeKb     Int
  uploadedAt DateTime @default(now())
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  /// Mottakeren av varselet.
  userId    String
  groupId   String?
  type      NotificationType
  text      String
  href      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      Person           @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// En samtale: enten gruppechatten til en gruppe (groupId satt, alle medlemmer i gruppen har
/// tilgang) eller en direktemelding mellom to personer (groupId null, to ConversationMember-rader).
model Conversation {
  id        String               @id @default(cuid())
  /// Brukes bare som reserve. Gruppechatter vises med gruppenavnet, direktemeldinger med navnet
  /// til den andre personen.
  title     String               @default("")
  /// Maks én gruppechat per gruppe.
  groupId   String?              @unique
  createdAt DateTime             @default(now())
  group     Group?               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  members   ConversationMember[]
  messages  Message[]
}

/// Deltaker i en samtale. For gruppechatter lages raden første gang man åpner chatten, og brukes
/// bare til lest-status. For direktemeldinger avgjør radene hvem som har tilgang.
model ConversationMember {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           Person       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  senderId       String
  /// Tom når meldingen er slettet.
  body           String
  sentAt         DateTime          @default(now())
  /// Meldingen dette er et svar på.
  replyToId      String?
  /// Slettede meldinger blir liggende som «Meldingen ble slettet», så svar på dem gir mening.
  deletedAt      DateTime?
  /// Sist teksten ble redigert. Null hvis den aldri er endret.
  editedAt       DateTime?
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         Person            @relation(fields: [senderId], references: [id])
  replyTo        Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]         @relation("MessageReplies")
  reactions      MessageReaction[]

  @@index([conversationId, sentAt])
}

/// En emoji-reaksjon på en melding. Samme person kan reagere med flere ulike emojier.
model MessageReaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      Person   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
}

/// Expo push-token for en enhet. Én enhet hører til én bruker om gangen (siste som logget inn).
model PushToken {
  token     String   @id
  userId    String
  platform  String
  updatedAt DateTime @updatedAt
  user      Person   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Varselinnstillinger. Raden lages første gang de endres; mangler den, gjelder standardverdiene.
model NotificationSettings {
  userId              String  @id
  /// Hovedbryteren. De andre gjelder bare når den er på.
  pushEnabled         Boolean @default(true)
  pushFines           Boolean @default(true)
  pushEventReminders  Boolean @default(true)
  pushSignupReminders Boolean @default(true)
  pushMessages        Boolean @default(true)
  user                Person  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// En «Gi bot»-innsending som er utført. Id-en lages i appen per utfylte skjema, så samme
/// innsending (dobbelttrykk, nytt forsøk etter nettfeil) ikke gir bøtene to ganger. Trengs også for
/// bøter på tihlde.org, som ikke stopper duplikater selv.
model FineRequest {
  id        String   @id
  userId    String
  createdAt DateTime @default(now())
}
