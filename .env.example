# Copy to .env in the repo root. This is the only env file in the project.

# Database (matches the container in infra/docker/docker-compose.dev.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/sporty_v3

# Better Auth
BETTER_AUTH_URL=http://localhost:3001
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# TIHLDE login through Photon. Required: nobody can sign in without it.
# The client must have <BETTER_AUTH_URL>/api/auth/callback/photon as a redirect URI.
PHOTON_CLIENT_ID=
PHOTON_CLIENT_SECRET=
# PHOTON_ISSUER=https://photon.tihlde.org/api/auth

# Mobilappen (Sporty Native) bruker API-et under /api med sitt eget Photon-token
# (Authorization: Bearer). Klient-ID-en til appens OAuth-klient på tihlde.org (offentlig klient):
# bare tokens laget for den godtas.
PHOTON_APP_CLIENT_ID=

# Kun i utvikling: lar en innlogget bruker opptre som andre brukere (appens «Bytt bruker»).
# ALDRI slå på i produksjon.
# ALLOW_DEV_USER_SWITCH=true

