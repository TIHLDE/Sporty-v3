{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": [
				"^build"
			],
			"outputs": [
				"dist/**"
			]
		},
		"check-types": {
			"dependsOn": [
				"^check-types"
			]
		},
		"dev": {
			"dependsOn": [
				"@sporty/db#db:push"
			],
			"cache": false,
			"persistent": true
		},
		"dev:up": {
			"cache": false
		},
		"db:push": {
			"dependsOn": [
				"db:generate",
				"@sporty/docker#dev:up"
			],
			"cache": false,
			"interactive": true
		},
		"db:generate": {
			"cache": false,
			"interactive": false
		},
		"db:migrate": {
			"dependsOn": [
				"@sporty/docker#dev:up"
			],
			"cache": false,
			"interactive": true
		},
		"db:studio": {
			"dependsOn": [
				"@sporty/docker#dev:up"
			],
			"cache": false,
			"persistent": true
		},
		"db:seed": {
			"dependsOn": [
				"db:generate",
				"@sporty/docker#dev:up"
			],
			"cache": false
		}
	},
	"globalEnv": [
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"CI",
		"DATABASE_URL",
		"NODE_ENV",
		"PHOTON_APP_CLIENT_ID",
		"PHOTON_ISSUER",
		"VERCEL",
		"VERCEL_ENV",
		"VERCEL_PROJECT_PRODUCTION_URL",
		"VERCEL_URL"
	],
	"globalDependencies": [
		".env"
	]
}
