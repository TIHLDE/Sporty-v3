{
	"name": "sporty-v3",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*",
			"infra/*"
		],
		"catalog": {
			"zod": "^4.5.4",
			"typescript": "^6.0.3",
			"lucide-react": "^1.41.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.8",
			"tailwindcss": "^4.3.3",
			"@prisma/client": "^7.10.0",
			"@trpc/server": "^11.18.0",
			"@trpc/client": "^11.18.0",
			"better-auth": "1.7.5",
			"@types/react": "^19.2.18",
			"@types/react-dom": "^19.2.7"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt --check",
		"format:fix": "oxfmt",
		"db:push": "turbo run db:push -F @sporty/db --",
		"db:studio": "turbo run db:studio -F @sporty/db --",
		"db:generate": "turbo run db:generate -F @sporty/db --",
		"db:migrate": "turbo run db:migrate -F @sporty/db --",
		"db:seed": "turbo run db:seed -F @sporty/db --",
		"docker:dev": "bun run --cwd infra/docker dev:up",
		"docker:dev:down": "bun run --cwd infra/docker dev:down",
		"docker:fresh": "bun run --cwd infra/docker dev:fresh",
		"docker:prod": "bun run --cwd infra/docker prod:up",
		"docker:prod:down": "bun run --cwd infra/docker prod:down"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@sporty/config": "workspace:*",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.4.1",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"turbo": "^2.10.12",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.14"
}
